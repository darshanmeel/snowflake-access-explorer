# Settings of the app inside Snowflake (sql/4_streamlit.sql uploads sis/.env as the app's .env).
# mkdir sis, then copy this file to sis/.env (git-ignored) and fill it in.
# INSIDE=1: the app runs inside Snowflake and uses its own session (it also finds that session by itself).
# Never SNOWFLAKE_ACCOUNT or a key here.
INSIDE=1
# Pick one source (README > Deploy):
# objects (recommended for a team): the TBL_ACCESS_ snapshot tables, filled by SP_ACCESS_SNAPSHOT
#   (sql/1_setup.sql, 2_snapshot.sql, a daily task). Fast to open, every viewer sees the same snapshot.
SOURCE=objects
ACCESS_SNAPSHOT=<DB>.<SCHEMA>
# direct: no tables, procedures or task (only 4_streamlit.sql). The app reads ACCOUNT_USAGE live with its owner role
#   (DEV_ROLE), which needs IMPORTED PRIVILEGES ON DATABASE SNOWFLAKE (or the SNOWFLAKE database roles
#   SECURITY_VIEWER + GOVERNANCE_VIEWER). Each viewer's session reads once, on "Load shared data". Future grants and
#   streams need SHOW: when Snowflake refuses SHOW there, they show up under Incomplete.
# SOURCE=direct
