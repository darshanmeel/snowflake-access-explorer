# Settings of the app inside Snowflake (sql/4_streamlit.sql uploads sis/.env as the app's .env). Copy to sis/.env (git-ignored).
# Never SNOWFLAKE_ACCOUNT or a key here: without it the app knows it runs inside Snowflake and uses its own session.
# objects: the TBL_ACCESS_ snapshot tables (sql/1_setup.sql, 2_snapshot.sql). Direct reads need SHOW, restricted in there.
SOURCE=objects
ACCESS_SNAPSHOT=<DB>.<SCHEMA>
