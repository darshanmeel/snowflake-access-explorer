# Settings of the app inside Snowflake (sql/4_streamlit.sql uploads sis/.env as the app's .env).
# mkdir sis, then copy this file to sis/.env (git-ignored) and fill it in.
# INSIDE=1: the app runs inside Snowflake and uses its own session (it also finds that session by itself).
# Never SNOWFLAKE_ACCOUNT or a key here.
INSIDE=1
# Pick one source (README > Deploy):
# objects (recommended for a team): the TBL_ACCESS_ snapshot tables, filled by SP_ACCESS_SNAPSHOT
#   (sql/1_setup.sql, 2_snapshot.sql, a daily task). Fast to open, every viewer sees the same snapshot.
SOURCE=objects
ACCESS_SNAPSHOT=<DB>.<SCHEMA>
# direct: no tables, procedures or task (only 4_streamlit.sql). The app reads ACCOUNT_USAGE live with its owner role
#   (DEV_ROLE), which needs IMPORTED PRIVILEGES ON DATABASE SNOWFLAKE (or the SNOWFLAKE database roles
#   SECURITY_VIEWER + GOVERNANCE_VIEWER). Each viewer's session reads once, on "Load shared data". Future grants and
#   streams need SHOW: when Snowflake refuses SHOW there, they show up under Incomplete.
# SOURCE=direct
# Name of this app in Snowflake (default ST_ACCESS_EXPLORER); must match !define STREAMLIT_APP in settings.local.sql,
#   so the Activity tabs leave the app's own queries out.
# STREAMLIT_APP=ST_ACCESS_EXPLORER
# Query tag of the local app (default access-explorer); must match !define QUERY_TAG in settings.local.sql and QUERY_TAG
#   in the local .env, so Direct mode here leaves the local app's queries out of the Activity tabs.
# QUERY_TAG=access-explorer
# CSV=0: hide every CSV button and refuse CSV downloads (people who can open the app still see the screen)
# CSV=0
# STATEMENT_TIMEOUT: seconds each statement may run (default 300 = 5 min, 0 = Snowflake's own). A read that stops says
#   which step; give it longer with STATEMENT_TIMEOUT=600 (10 min).
# STATEMENT_TIMEOUT=300
# WORKERS: heavy reads at once on the app's session (default 3); 1 = one after another, if Snowflake refuses
#   statements running side by side here
# WORKERS=3
# ACTIVITY=0: read no ACCESS_HISTORY (Activity tabs, rules 24-28 and Granted vs used show "skipped (ACTIVITY=0)")
# ACTIVITY=0
# HIERARCHY=0: skip the rule checks that walk role paths (Risks & fixes lists them as skipped); pages still walk
# HIERARCHY=0
