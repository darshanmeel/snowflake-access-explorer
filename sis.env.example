# Settings of the app inside Snowflake (sql/4_streamlit.sql uploads sis/.env as the app's .env).
# mkdir sis, then copy this file to sis/.env (git-ignored) and fill it in.
# INSIDE=1: the app runs inside Snowflake and uses its own session (it also finds that session by itself).
# Never SNOWFLAKE_ACCOUNT or a key here.
INSIDE=1
# objects: the TBL_ACCESS_ snapshot tables (sql/1_setup.sql, 2_snapshot.sql). Direct reads need SHOW, restricted in there.
SOURCE=objects
ACCESS_SNAPSHOT=<DB>.<SCHEMA>
