# Copy to .env (git-ignored) and fill in. NAME=value, one per line (no comment after a value); a name left out or empty here comes from the environment variables; a variable already set in the shell wins.

# Data comes from Snowflake. For fake data run: python run.py --fake (or FAKE=1)
# FAKE=1
# direct = read grants with your role, nothing created in Snowflake; objects = the TBL_ACCESS_ snapshot tables
SOURCE=direct
# objects: <DB>.<SCHEMA> of the snapshot tables; empty = SNOWFLAKE_DATABASE.SNOWFLAKE_SCHEMA below
ACCESS_SNAPSHOT=
# Data is kept this many hours in .cache/ (git-ignored); 0 = memory only. Memory keeps it 24 h either way.
CACHE_HOURS=24
# python run.py: default app (web | streamlit) and ports
# APP=web
# WEB_PORT=8000
# STREAMLIT_PORT=8501
# Shared server: HOST=0.0.0.0; more host names it answers (a DNS alias, a proxy), comma-separated
# ALLOWED_HOSTS=
# My access: off on a shared server and with a key pair (a service user); 1 = on (the key pair is your own user), 0 = off
# MY_ACCESS=

# Snowflake login: browser SSO, or key pair when SNOWFLAKE_PRIVATE_KEY_FILE is set
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake login name>
# role: <APP_ROLE> with the tables; direct: a role that can read ACCOUNT_USAGE (else SHOW sees less)
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_WAREHOUSE=<WH>
# SNOWFLAKE_DATABASE=<a database you can use; My access reads query history through it>
# SNOWFLAKE_SCHEMA=<schema of the snapshot tables, with SOURCE=objects>
# SNOWFLAKE_PRIVATE_KEY_FILE=C:\path\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PWD=<passphrase>

# Optional (README.html > Settings): ROLE_PREFIXES, BUILD_ROLES, DORMANT_DAYS, SENSITIVE_TAGS, ...
# ROLE_PREFIXES=F_,T_
# The app's own queries, left out of the Activity tabs; same values as QUERY_TAG / STREAMLIT_APP in settings.local.sql
# QUERY_TAG=access-explorer
# STREAMLIT_APP=ST_ACCESS_EXPLORER
# PrivateLink: the private host, e.g. <org>-<account>.privatelink.snowflakecomputing.com (README > PrivateLink)
# SNOWFLAKE_HOST=
# CSV=0: hide every CSV button and refuse CSV downloads (people who can open the app still see the screen)
# CSV=0

# STATEMENT_TIMEOUT: seconds each statement may run, the snapshot CALL included (default 300 = 5 min, 0 = Snowflake's own)
# STATEMENT_TIMEOUT=300
# WORKERS: heavy reads at once on the one connection (default 3, 1 = one after another); SHOW_THREADS: the light ones
# WORKERS=3
# ACTIVITY=0: read no ACCESS_HISTORY (object use, activity); the Activity tabs and rules 24-28 say skipped
# ACTIVITY=0
# HIERARCHY=0: skip the rule checks that walk role paths; Risks & fixes lists them as skipped
# HIERARCHY=0

# Folder for the local copy (default .cache next to the app); an existing one is used, a missing one is created
# CACHE_DIR=.cache
