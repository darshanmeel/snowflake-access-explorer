# Copy to .env (git-ignored) and fill in. NAME=value, one per line (no comment after a value); a name left out or empty here comes from the environment variables; a variable already set in the shell wins.

# Data: FAKE=1 fake data · FAKE=0 Snowflake
FAKE=0
# <DB>.<SCHEMA> of the snapshot tables; empty = direct mode (no tables or procedures: reads grants with your role)
ACCESS_SNAPSHOT=

# Snowflake login: browser SSO, or key pair when SNOWFLAKE_PRIVATE_KEY_FILE is set
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake login name>
# role: <APP_ROLE> with the tables; direct mode: a role that can read ACCOUNT_USAGE (else SHOW sees less)
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_WAREHOUSE=<WH>
# SNOWFLAKE_DATABASE=<a database you can use; My access reads query history through it>
# SNOWFLAKE_PRIVATE_KEY_FILE=C:\path\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PWD=<passphrase>

# Optional (README.html > Settings): ROLE_PREFIXES, BUILD_ROLES, DORMANT_DAYS, SENSITIVE_TAGS, ...
# ROLE_PREFIXES=F_,T_
