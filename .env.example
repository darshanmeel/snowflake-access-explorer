# Copy to .env (git-ignored) and fill in. NAME=value, one per line (no comment after a value); a name left out or empty here comes from the environment variables; a variable already set in the shell wins.

# Data comes from Snowflake. For fake data run: python run.py --fake (or FAKE=1)
# FAKE=1
# direct = read grants with your role, nothing created in Snowflake; objects = the TBL_ACCESS_ snapshot tables
SOURCE=direct
# objects: <DB>.<SCHEMA> of the snapshot tables; empty = SNOWFLAKE_DATABASE.SNOWFLAKE_SCHEMA below
ACCESS_SNAPSHOT=
# Data is kept this many hours in .cache/ (git-ignored); 0 = memory only. Memory keeps it 24 h either way.
CACHE_HOURS=24
# python run.py: default app (web | streamlit) and ports
# APP=web
# WEB_PORT=8000
# STREAMLIT_PORT=8501

# Snowflake login: browser SSO, or key pair when SNOWFLAKE_PRIVATE_KEY_FILE is set
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake login name>
# role: <APP_ROLE> with the tables; direct: a role that can read ACCOUNT_USAGE (else SHOW sees less)
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_WAREHOUSE=<WH>
# SNOWFLAKE_DATABASE=<a database you can use; My access reads query history through it>
# SNOWFLAKE_SCHEMA=<schema of the snapshot tables, with SOURCE=objects>
# SNOWFLAKE_PRIVATE_KEY_FILE=C:\path\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PWD=<passphrase>

# Optional (README.html > Settings): ROLE_PREFIXES, BUILD_ROLES, DORMANT_DAYS, SENSITIVE_TAGS, ...
# ROLE_PREFIXES=F_,T_
