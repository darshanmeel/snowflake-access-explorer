# Copy to .env (git-ignored) and fill in. NAME=value, one per line; a variable already set in the shell wins.

# Data: FAKE=1 fake data · DUCKDB=demo.duckdb local demo · FAKE=0 and DUCKDB empty = Snowflake
FAKE=0
DUCKDB=
ACCESS_SNAPSHOT=<DB>.<SCHEMA>

# Snowflake login: browser SSO, or key pair when SNOWFLAKE_PRIVATE_KEY_FILE is set
SNOWFLAKE_ACCOUNT=<org>-<account>
SNOWFLAKE_USER=<your Snowflake login name>
SNOWFLAKE_ROLE=<APP_ROLE>
SNOWFLAKE_WAREHOUSE=<WH>
# SNOWFLAKE_PRIVATE_KEY_FILE=C:\path\rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PWD=<passphrase>

# Optional (README > Settings): ROLE_PREFIXES, BUILD_ROLES, DORMANT_DAYS, SENSITIVE_TAGS, ...
# ROLE_PREFIXES=F_,T_
