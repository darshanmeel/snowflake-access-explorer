#!/bin/sh
# Blocks any commit whose staged files or file names contain a company term.
# Terms: one extended regex per line in ~/.company-terms.txt, kept outside the repo so the names never enter it.
list="$HOME/.company-terms.txt"
[ -s "$list" ] || { echo "pre-commit: $list missing or empty, commit blocked"; exit 1; }
if git grep --cached -I -n -i -E -f "$list" || git diff --cached --name-only | grep -i -E -f "$list"; then
  echo "pre-commit: company terms found (above), commit blocked"
  exit 1
fi
